# ── Gemini (required — all 3 pipelines use this) ─────────────────────────────
GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash          # default; override if you have a different model
# GEMINI_INPUT_PRICE=0.15                # $/1M input tokens
# GEMINI_OUTPUT_PRICE=0.60               # $/1M output tokens

# ── TigerGraph Savanna (required for Pipeline 3 / GraphRAG) ──────────────────
# Get these from tgcloud.io → your instance → Connection Details
TG_HOST=https://<your-instance-id>.tg-<region>.i.tgcloud.io
TG_PASSWORD=<your-tg-secret>        # the Secret shown in Savanna, NOT your login password
TG_GRAPH=MyDatabase                 # graph name you created in Savanna
